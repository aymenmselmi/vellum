# For an existing PostgreSQL database. `npm run setup` can generate a local .env instead.
DATABASE_URL=postgresql://vellum_app:replace_me@127.0.0.1:5432/vellum
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:3000
APP_TIMEZONE=Africa/Tunis
NODE_ENV=development
# Enable certificate verification for a hosted PostgreSQL service.
DATABASE_SSL=false
ADMIN_EMAIL=admin@vellum.local
ADMIN_NAME=Vellum Admin
ADMIN_PASSWORD=replace_with_a_long_unique_password
# Set only when deployed behind a known reverse proxy.
TRUST_PROXY=0
# Docker mode only: set to the same database password used in DATABASE_URL.
# POSTGRES_PASSWORD=replace_me
# Optional separate PostgreSQL connection for automated tests.
# TEST_DATABASE_URL=postgresql://vellum_app:replace_me@127.0.0.1:5432/vellum_test
