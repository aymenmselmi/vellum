{
  "name": "vellum-car-rental",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --env-file-if-exists=.env --watch server/index.js",
    "setup": "node scripts/setup.js",
    "db:start": "node scripts/local-db.js start",
    "db:stop": "node scripts/local-db.js stop",
    "db:migrate": "node --env-file-if-exists=.env server/migrate.js",
    "db:seed": "node --env-file-if-exists=.env server/seed.js",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1 tests/api.test.js",
    "test:db": "node --env-file-if-exists=.env --test --test-concurrency=1 tests/database.test.js",
    "test:ui": "node --env-file-if-exists=.env tests/smoke.cjs"
  },
  "dependencies": {
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "playwright": "^1.65.0"
  }
}
